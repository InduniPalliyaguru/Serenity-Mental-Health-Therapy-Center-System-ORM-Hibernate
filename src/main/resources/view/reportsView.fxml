<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="637.0" prefWidth="1185.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #E2E8F0; -fx-border-width: 1;" stylesheets="@../styleSheets/therapyProgram.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.serenitymentalhealththerepycentersystem.controller.ReportsController">
    <children>
        <Label layoutX="40.0" layoutY="25.0" text="Reporting &amp; Analytics Dashboard" textFill="#003366">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <TabPane layoutX="25.0" layoutY="85.0" prefHeight="530.0" prefWidth="1135.0" style="-fx-background-color: transparent; -fx-tab-max-width: 250; -fx-tab-min-width: 180;" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab style="-fx-font-weight: bold; -fx-font-size: 13;" text="Financial Insights">
                    <content>
                        <AnchorPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #E2E8F0;">
                            <children>
                                <HBox alignment="CENTER_LEFT" layoutX="25.0" layoutY="20.0" spacing="15.0">
                                    <children>
                                        <Label text="Filter by Date:" textFill="#475569">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <DatePicker fx:id="dpFromDate" prefHeight="35.0" prefWidth="160.0" promptText="From Date" style="-fx-background-radius: 8;" />
                                        <DatePicker fx:id="dpToDate" prefHeight="35.0" prefWidth="160.0" promptText="To Date" style="-fx-background-radius: 8;" />
                                        <Button mnemonicParsing="false" onAction="#btnGenerateFinancialReportOnAction" prefHeight="35.0" prefWidth="180.0" styleClass="btn-save" text="Generate Financial Report" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tblPayments" layoutX="25.0" layoutY="75.0" prefHeight="395.0" prefWidth="1085.0" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="colPayId" prefWidth="237.06663131713867" style="-fx-alignment: CENTER;" text="Payment ID" />
                                        <TableColumn fx:id="colPatientName" prefWidth="509.33338928222656" text="Patient Name" />
                                        <TableColumn fx:id="colAmountPaid" prefWidth="339.19989013671875" style="-fx-alignment: CENTER-RIGHT;" text="Amount Paid (LKR)" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab fx:id="tabPerformance" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Performance &amp; Statistics">
                    <content>
                        <AnchorPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #E2E8F0;">
                            <children>
                                <BarChart fx:id="barChartPerformance" alternativeRowFillVisible="false" horizontalGridLinesVisible="false" layoutX="25.0" layoutY="20.0" legendVisible="false" prefHeight="435.0" prefWidth="560.0" title="Sessions Handled per Therapist" verticalGridLinesVisible="false">
                                    <xAxis><CategoryAxis side="BOTTOM" fx:id="xAxisTherapists" /></xAxis>
                                    <yAxis><NumberAxis label="Total Sessions" side="LEFT" /></yAxis>
                                </BarChart>

                                <PieChart fx:id="pieChartPrograms" layoutX="620.0" layoutY="35.0" prefHeight="410.0" prefWidth="480.0" title="Therapy Program Statistics" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab style="-fx-font-weight: bold; -fx-font-size: 13;" text="Patient Therapy History">
                    <content>
                        <AnchorPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #E2E8F0;">
                            <children>
                                <HBox alignment="CENTER_LEFT" layoutX="25.0" layoutY="20.0" spacing="15.0">
                                    <children>
                                        <TextField fx:id="txtSearchPatientId" prefHeight="35.0" prefWidth="280.0" promptText="Enter Patient ID to explore history..." style="-fx-background-radius: 8; -fx-border-radius: 8;" />
                                        <Button mnemonicParsing="false" onAction="#btnSearchHistoryOnAction" prefHeight="35.0" prefWidth="140.0" styleClass="btn-save" text="Search History" />
                                        <Label text="(Read-Only Secured View)" textFill="#94A3B8">
                                            <font>
                                                <Font name="System Italic" size="13.0" />
                                            </font>
                                            <padding><Insets left="10.0" /></padding>
                                        </Label>
                                    </children>
                                </HBox>

                                <TableView fx:id="tblHistory" layoutX="25.0" layoutY="75.0" prefHeight="395.0" prefWidth="1085.0" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                                    <columns>
                                        <TableColumn fx:id="colDate" prefWidth="140.0" style="-fx-alignment: CENTER;" text="Session Date" />
                                        <TableColumn fx:id="colProgram" prefWidth="240.0" text="Enrolled Therapy Program" />
                                        <TableColumn fx:id="colTherapist" prefWidth="220.0" text="Assigned Therapist" />
                                        <TableColumn fx:id="colHistoryStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Session Status" />
                                        <TableColumn fx:id="colNotes" prefWidth="310.0" text="Clinical &amp; Progress Notes" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </children>
</AnchorPane>
