        <Label alignment="CENTER" text="© 2026 Serenity Mental Health Therapy Center. All Rights Reserved." textFill="#555555" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
