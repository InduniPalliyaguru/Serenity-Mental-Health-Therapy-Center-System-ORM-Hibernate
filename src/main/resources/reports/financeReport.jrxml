<jasperReport name="financial_report" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f29d8463-b883-49d2-974d-91b7e411b026">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SerenityDB_Connection"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="fromDate" class="java.sql.Date"/>
	<parameter name="toDate" class="java.sql.Date"/>
	<query language="sql"><![CDATA[SELECT 
            p.payment_id AS paymentId,
            pt.name AS patientName,
            p.amount AS amount,
            p.payment_date AS paymentDate
        FROM 
            payment p
        INNER JOIN 
            patient pt ON p.patient_id = pt.patient_id
        WHERE 
            p.payment_date BETWEEN $P{fromDate} AND $P{toDate}
        ORDER BY 
            p.payment_date DESC]]></query>
	<field name="paymentId" class="java.lang.String"/>
	<field name="patientName" class="java.lang.String"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="paymentDate" class="java.sql.Date"/>
