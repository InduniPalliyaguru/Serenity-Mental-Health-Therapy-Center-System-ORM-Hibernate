                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="30" width="70" height="15" forecolor="#555555"/>
                <textElement>
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Patient ID :]]></text>
            </staticText>
            <textField>
                <reportElement x="75" y="30" width="145" height="15" forecolor="#333333"/>
                <textElement>
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{patient_id}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="50" width="70" height="15" forecolor="#555555"/>
                <textElement>
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Name :]]></text>
            </staticText>
            <textField>
                <reportElement x="75" y="50" width="145" height="15" forecolor="#333333"/>
                <textElement>
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{patient_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="5" width="120" height="18" forecolor="#0D5C5A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[INVOICE DETAILS]]></text>
            </staticText>
            <line>
                <reportElement x="340" y="23" width="215" height="1" forecolor="#0D5C5A"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="340" y="30" width="90" height="15" forecolor="#555555"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date :]]></text>
            </staticText>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="440" y="30" width="115" height="15" forecolor="#333333"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{payment_date}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="50" width="90" height="15" forecolor="#555555"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Status :]]></text>
            </staticText>
            <textField>
                <reportElement x="440" y="50" width="115" height="15" forecolor="#00875A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{payment_status}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    <columnHeader>
        <band height="30" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#0D5C5A"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="0" width="305" height="25" forecolor="#FFFFFF"/>
