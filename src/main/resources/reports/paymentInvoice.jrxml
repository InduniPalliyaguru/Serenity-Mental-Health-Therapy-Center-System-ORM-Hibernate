                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#E0F2F1"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="285" y="15" width="135" height="20" forecolor="#555555"/>
                <textElement verticalAlignment="Middle">
