                </textElement>
                <text><![CDATA[Total Program Fee :]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="430" y="15" width="110" height="20" forecolor="#333333"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
