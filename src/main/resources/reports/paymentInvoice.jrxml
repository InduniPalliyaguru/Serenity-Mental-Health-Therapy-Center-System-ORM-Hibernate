<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="paymentInvoice" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="SerenityDB_Connection"/>
    <property name="com.jaspersoft.studio.data.sql.tables" value=""/>
    <parameter name="p_payment_id" class="java.lang.String"/>
    <queryString language="sql">
        <![CDATA[SELECT
    p.payment_id AS payment_id,
    p.amount AS current_amount,
    p.payment_date AS payment_date,
    'Paid' AS payment_status,
    pt.name AS patient_name,
    pt.patient_id AS patient_id,
    prog.programName AS program_name,
    prog.fee AS total_program_fee,
    (SELECT SUM(p2.amount) FROM payment p2 WHERE p2.patient_id = p.patient_id AND p2.program_id = p.program_id AND p2.payment_date <= p.payment_date) AS total_paid_so_far,
    (prog.fee - (SELECT SUM(p2.amount) FROM payment p2 WHERE p2.patient_id = p.patient_id AND p2.program_id = p.program_id AND p2.payment_date <= p.payment_date)) AS remaining_balance
FROM payment p
JOIN patient pt ON p.patient_id = pt.patient_id
JOIN therapy_programs prog ON p.program_id = prog.programId
WHERE p.payment_id = $P{p_payment_id}]]>
    </queryString>
    <field name="payment_id" class="java.lang.String"/>
    <field name="current_amount" class="java.math.BigDecimal"/>
    <field name="payment_date" class="java.sql.Date"/>
    <field name="payment_status" class="java.lang.String"/>
    <field name="patient_name" class="java.lang.String"/>
    <field name="patient_id" class="java.lang.String"/>
    <field name="program_name" class="java.lang.String"/>
    <field name="total_program_fee" class="java.math.BigDecimal"/>
    <field name="total_paid_so_far" class="java.math.BigDecimal"/>
    <field name="remaining_balance" class="java.math.BigDecimal"/>
    <background>
        <band splitType="Stretch"/>
    </background>
    <title>
        <band height="95" splitType="Stretch">
            <rectangle radius="10">
                <reportElement x="0" y="0" width="555" height="85" backcolor="#0D5C5A"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="15" width="310" height="35" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[SERENITY MENTAL HEALTH]]></text>
            </staticText>
            <staticText>
                <reportElement x="20" y="50" width="250" height="20" forecolor="#E0F2F1"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isItalic="true"/>
                </textElement>
                <text><![CDATA[Therapy Center & Holistic Wellness System]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="15" width="155" height="35" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="22" isBold="true"/>
                </textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>
            <textField>
                <reportElement x="380" y="50" width="155" height="20" forecolor="#E0F2F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Invoice No: " + $F{payment_id}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <pageHeader>
        <band height="90" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="5" width="120" height="18" forecolor="#0D5C5A"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[PATIENT DETAILS]]></text>
            </staticText>
            <line>
